# Backend Server Port (automatically set by Render/Railway or defaults to 5000)
PORT=5000

# MongoDB Atlas Connection String
# IMPORTANT: In MongoDB Atlas -> Network Access, ensure 0.0.0.0/0 is whitelisted for cloud hosting.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/agrirent?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=agrirent-super-secret-production-key-987654
